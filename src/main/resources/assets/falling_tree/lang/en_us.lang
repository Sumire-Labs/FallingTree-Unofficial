# Chat messages
chat.falling_tree.tree_too_big=This tree is too big and can't be broken in one hit (size: %d, max: %d)
chat.falling_tree.prevented_break_tool=Your tool is about to break, go repair it or get a new one

# Config - General
falling_tree.config.reverse_sneaking=Reverse Sneaking
falling_tree.config.reverse_sneaking.tooltip=When enabled, a tree will only be chopped down if the player is sneaking.
falling_tree.config.break_in_creative=Break in Creative
falling_tree.config.break_in_creative.tooltip=When enabled, the mod will cut down trees in creative mode too.

# Config - Trees
falling_tree.config.trees=Trees
falling_tree.config.trees.tooltip=Settings related to tree detection and breaking.
falling_tree.config.trees.logs_whitelisted=Whitelisted Logs
falling_tree.config.trees.logs_whitelisted.tooltip=Additional blocks considered as logs that will be destroyed by the mod. Blocks with the log tag are already whitelisted.
falling_tree.config.trees.logs_blacklisted=Blacklisted Logs
falling_tree.config.trees.logs_blacklisted.tooltip=Blocks that should not be considered as logs. This wins over the whitelist.
falling_tree.config.trees.leaves_whitelisted=Whitelisted Leaves
falling_tree.config.trees.leaves_whitelisted.tooltip=Additional blocks considered as leaves. Blocks with the leaves tag are already whitelisted.
falling_tree.config.trees.leaves_blacklisted=Blacklisted Leaves
falling_tree.config.trees.leaves_blacklisted.tooltip=Blocks that should not be considered as leaves. This wins over the whitelist.
falling_tree.config.trees.break_mode=Break Mode
falling_tree.config.trees.break_mode.tooltip=How to break the tree. INSTANTANEOUS breaks it in one go. SHIFT_DOWN makes logs fall as you cut.
falling_tree.config.trees.logs_max_count=Max Log Count
falling_tree.config.trees.logs_max_count.tooltip=The maximum number of logs in a tree. Trees larger than this won't be cut. Only in INSTANTANEOUS mode.
falling_tree.config.trees.minimum_leaves_around_required=Min Leaves Around Top
falling_tree.config.trees.minimum_leaves_around_required.tooltip=The minimum number of leaves adjacent to the topmost log to consider it a tree. Only in INSTANTANEOUS mode.
falling_tree.config.trees.minimum_leaves_ratio=Min Leaves Ratio
falling_tree.config.trees.minimum_leaves_ratio.tooltip=The minimum ratio of logs that must have at least one adjacent leaf. e.g. 0.1 means 10%% of logs must touch a leaf. Set to 0 to disable. Checks all logs in the tree.
falling_tree.config.trees.leaves_breaking=Break Leaves
falling_tree.config.trees.leaves_breaking.tooltip=When enabled, leaves that should naturally break will be broken instantly.
falling_tree.config.trees.leaves_breaking_force_radius=Force Break Leaves Radius
falling_tree.config.trees.leaves_breaking_force_radius.tooltip=Radius to force break leaves from the topmost log. Even persistent (player-placed) leaves will be destroyed. Requires Break Leaves to be enabled. Only in INSTANTANEOUS mode.
falling_tree.config.trees.allow_mixed_logs=Allow Mixed Logs
falling_tree.config.trees.allow_mixed_logs.tooltip=When enabled, any kind of log can be part of a tree trunk. Otherwise only one kind of log is considered.

# Config - Tools
falling_tree.config.tools=Tools
falling_tree.config.tools.tooltip=Settings related to tool behavior.
falling_tree.config.tools.whitelisted=Whitelisted Tools
falling_tree.config.tools.whitelisted.tooltip=Additional tools that can be used to chop down a tree. Items with the axe tag are already whitelisted.
falling_tree.config.tools.blacklisted=Blacklisted Tools
falling_tree.config.tools.blacklisted.tooltip=Tools that should not be used with this mod. This wins over the whitelist.
falling_tree.config.tools.preserve=Preserve Tool
falling_tree.config.tools.preserve.tooltip=When enabled, if a tool is about to break, only enough blocks will be broken to leave the tool at 1 durability.
falling_tree.config.tools.ignore_tools=Ignore Tools
falling_tree.config.tools.ignore_tools.tooltip=When enabled, the mod works regardless of what you hold (or empty hand). Blacklist can still restrict specific tools.
falling_tree.config.tools.damage_multiplicand=Damage Multiplier
falling_tree.config.tools.damage_multiplicand.tooltip=How many times durability damage is applied per log. e.g. 1 = 5 logs gives 5 damage. 0 = always 1 damage per cut.
falling_tree.config.tools.speed_multiplicand=Speed Multiplier
falling_tree.config.tools.speed_multiplicand.tooltip=Breaking speed modifier. 0 = default speed. 1 = each log counted once. 2 = each log counted twice. Only in INSTANTANEOUS mode. On servers, set to 0 or ensure all players have the mod.
